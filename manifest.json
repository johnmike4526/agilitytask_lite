{
  "manifest_version": 3,
  "name": "Agility Task Lite",
  "version": "1.0.0",
  "description": "Burndown, carga por desarrollador, agenda y buscador de tareas sobre la API de AgilityTask.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Agility Task Lite",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/dashboard.html"
}